{{- $index := slice -}}
{{- range where .Site.RegularPages "Type" "not in" (slice "page" "json") -}}
  {{- $page := . -}}
  {{- if eq $page.Language.Lang .Site.Language.Lang -}}
    {{- $index = $index | append (dict 
      "uri" $page.RelPermalink
      "title" $page.Title
      "content" $page.Plain
      "tags" $page.Params.tags
      "language" $page.Language.Lang
    ) -}}
  {{- end -}}
{{- end -}}
{{- $index | jsonify -}}